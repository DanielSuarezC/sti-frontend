# URL base de la API. Déjala vacía para usar "/api/v1" (proxy same-origin en dev y en Cloudflare Pages).
# VITE_API_URL=/api/v1

# Solo para Cloudflare Pages Functions (functions/api/[[path]].js): URL del backend en Render, sin barra final.
# Se configura como variable/secreto del proyecto en Cloudflare, NO con prefijo VITE_.
BACKEND_URL=https://sti-backend.onrender.com
